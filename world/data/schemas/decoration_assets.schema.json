{
  "$id": "decoration_assets.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "manifestId",
      "footprint"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "manifestId": {
        "type": "string"
      },
      "footprint": {
        "type": "object",
        "required": [
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        }
      },
      "defaultInteractions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
