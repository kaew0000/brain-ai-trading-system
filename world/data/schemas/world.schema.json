{
  "$id": "world.schema.json",
  "type": "object",
  "required": [
    "version",
    "timestamp",
    "engineStatus"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "engineStatus": {
      "type": "string",
      "enum": [
        "idle",
        "active",
        "recovering",
        "halted"
      ]
    },
    "activeDistricts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activeAgents": {
      "type": "array",
      "description": "Added Phase W4 (ingestion adapter) — agent refs (e.g. PRIMUS) currently reflected as active. Optional and additive; does not affect any Phase W1-W3 consumer of this schema.",
      "items": {
        "type": "string"
      }
    }
  }
}
