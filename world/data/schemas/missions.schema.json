{
  "$id": "missions.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "district",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "district": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "proposed",
          "active",
          "complete",
          "aborted"
        ]
      }
    }
  }
}
