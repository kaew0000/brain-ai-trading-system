# ════════════════════════════════════════════════════════════
# Brain Bot V13 — Environment Configuration
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════

# ── Execution Mode ────────────────────────────────────────
# paper    = PaperExecutionEngine (no real orders, DEFAULT)
# testnet  = Binance Futures Testnet (fake money, real API)
# live     = Binance Futures Mainnet ⚠️ REAL MONEY ⚠️
EXECUTION_MODE=paper

# ── Binance Mainnet (data fetch only for paper/testnet) ──
BINANCE_API_KEY=your_mainnet_api_key_here
BINANCE_API_SECRET=your_mainnet_api_secret_here

# ── Binance Testnet (used when EXECUTION_MODE=testnet) ───
# Get keys at: https://testnet.binancefuture.com
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# ── Trading Parameters ────────────────────────────────────
SYMBOL=BTCUSDT
LEVERAGE=5
# ISOLATED (default) or CROSSED. Binance rejects ISOLATED (-4168) on
# accounts with Multi-Assets Mode enabled -- set CROSSED if that's your
# account's mode. Changes real trading risk; see config/settings.py.
MARGIN_TYPE=ISOLATED

# ── Risk Management ───────────────────────────────────────
RISK_PER_TRADE_MIN=0.005
RISK_PER_TRADE_MAX=0.01
MAX_DAILY_LOSS=0.03
MAX_CONSECUTIVE_LOSSES=3

# ── Loop Interval (seconds) ───────────────────────────────
LOOP_INTERVAL=60

# ── Dashboard API Authentication (P1-A) ───────────────────
# Secure by default — a fresh .env with these left blank still starts,
# but api/auth.py will generate an ephemeral OPERATOR API key and JWT
# signing secret for THIS PROCESS ONLY and log them once (they change
# on every restart). Set real values below before running anything
# beyond local/paper testing.
API_AUTH_ENABLED=true
# JSON object mapping raw API key -> role ("admin"|"operator"|"viewer")
# API_KEYS={"changeme-op-key":"operator","changeme-view-key":"viewer"}
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
