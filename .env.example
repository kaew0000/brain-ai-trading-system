# ════════════════════════════════════════════════════════════
# Brain Bot V13 — Environment Configuration
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════

# ── Execution Mode ────────────────────────────────────────
# paper    = PaperExecutionEngine (no real orders, DEFAULT)
# testnet  = Binance Futures Testnet (fake money, real API)
# live     = Binance Futures Mainnet ⚠️ REAL MONEY ⚠️
EXECUTION_MODE=paper

# ── Binance Mainnet (data fetch only for paper/testnet) ──
BINANCE_API_KEY=your_mainnet_api_key_here
BINANCE_API_SECRET=your_mainnet_api_secret_here

# ── Binance Testnet (used when EXECUTION_MODE=testnet) ───
# Get keys at: https://testnet.binancefuture.com
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# ── Trading Parameters ────────────────────────────────────
SYMBOL=BTCUSDT
LEVERAGE=5
# ISOLATED (default) or CROSSED. Binance rejects ISOLATED (-4168) on
# accounts with Multi-Assets Mode enabled -- set CROSSED if that's your
# account's mode. Changes real trading risk; see config/settings.py.
MARGIN_TYPE=ISOLATED

# ── Risk Management ───────────────────────────────────────
RISK_PER_TRADE_MIN=0.005
RISK_PER_TRADE_MAX=0.01
MAX_DAILY_LOSS=0.03
MAX_CONSECUTIVE_LOSSES=3

# ── Loop Interval (seconds) ───────────────────────────────
LOOP_INTERVAL=60

# ── Dashboard API Authentication (P1-A) ───────────────────
# Secure by default — a fresh .env with these left blank still starts,
# but api/auth.py will generate an ephemeral OPERATOR API key and JWT
# signing secret for THIS PROCESS ONLY and log them once (they change
# on every restart). Set real values below before running anything
# beyond local/paper testing.
API_AUTH_ENABLED=true
# JSON object mapping raw API key -> role ("admin"|"operator"|"viewer")
# API_KEYS={"changeme-op-key":"operator","changeme-view-key":"viewer"}
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
# V16 Phase 4C: how long the dashboard stays signed in across page
# refreshes/browser restarts without re-entering the API key (delivered
# as an httpOnly cookie, not the bearer token above — see api/auth.py).
JWT_REFRESH_EXPIRY_DAYS=7
# Set to false ONLY for local/dev over plain http:// — browsers refuse
# to persist a Secure cookie over a non-HTTPS connection, which would
# silently break session persistence in dev. Leave true otherwise.
COOKIE_SECURE=true

# ── HFT Flow — microstructure order-flow (V16 Phase 4C Track B) ──
# All four OFF by default; every trading decision is byte-identical to
# before this feature existed unless you explicitly opt in below. See
# docs/architecture.md section 45 for the full six-phase design and the
# "Enabling for live" procedure.
#
# 1) Master switch: turns on the real-time Binance WS depth/trade
#    ingestion (data/binance_ws_client.py) that everything else below
#    depends on. With this off, the other three settings have no effect
#    at all — there is no live data for them to act on.
HFT_WS_ENABLED=false
# 2) Opt-in switch for the additive confidence weight (HFT-6b). When
#    true, decision/confidence_engine.py::resolve_confidence_weights()
#    applies HFT_FLOW_LIVE_WEIGHT below to the hft_flow category instead
#    of the hardcoded 0.0 default.
HFT_FLOW_LIVE_ENABLED=false
# The weight applied when HFT_FLOW_LIVE_ENABLED=true (~5% of total
# confidence at the default of 5.0 — see config/settings.py's own
# comment for why this default is deliberately small).
HFT_FLOW_LIVE_WEIGHT=5.0
# 3) Independent opt-in for the contradiction penalty/block: a strongly
#    opposing hft_flow reading subtracts confidence points, and an
#    extreme opposing reading can force a hard BLOCKED action. Thresholds
#    in config/settings.py (HFT_FLOW_CONTRADICTION_REDUCE_THRESHOLD /
#    _BLOCK_THRESHOLD / _PENALTY_POINTS) if you need to tune them.
HFT_FLOW_CONTRADICTION_ENABLED=false

# ── ML Extensions Integration Layer (observe-only) ──
# Off by default; decision behavior is byte-identical to before this
# feature existed unless you explicitly opt in. When true, main.py's
# build_system() wires ml/extensions/'s RL/HPO/Online-Learning
# subpackage (PR #82) into the live agent layer for dashboard
# visibility only — see ml/extensions/integration/ml_extensions_agent.py's
# module docstring for why this cannot affect LONG/SHORT/WAIT. Also
# requires ml/extensions/'s optional dependencies (gymnasium,
# stable-baselines3, torch, river, optuna — see
# ml/extensions/requirements.txt) to be installed; if they aren't,
# wiring fails non-fatally and this behaves exactly as if false.
ML_EXTENSIONS_ENABLED=false

